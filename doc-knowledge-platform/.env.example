# Region for everything except rerank
AWS_DEFAULT_REGION=ap-southeast-2

# Bedrock Rerank is not available in ap-southeast-2, so only the rerank call uses this Region
RERANK_REGION=us-west-2
RERANK_MODEL_ID=amazon.rerank-v1:0

# Model IDs. In ap-southeast-2 Nova needs an APAC inference profile.
# Check with: aws bedrock list-inference-profiles --region ap-southeast-2
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
GENERATION_MODEL_ID=apac.amazon.nova-lite-v1:0
REWRITE_MODEL_ID=apac.amazon.nova-lite-v1:0
EMBEDDING_DIMENSIONS=1024
